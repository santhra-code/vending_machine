# ==============================================================================
# SANTRA DIGITAL VENDING MACHINE - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env.local for local development or set in Vercel Project Settings
# ==============================================================================

# 1. SUPABASE DATABASE (PostgreSQL)
# Obtain from your Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key-here

# 2. ADMIN AUTHENTICATION
# Random 32+ character secret for JWT session encryption (generate with: openssl rand -hex 32)
ADMIN_JWT_SECRET=your-random-32-character-secret-key-goes-here

# 3. RAZORPAY PAYMENT GATEWAY
# Obtain from your Razorpay Dashboard -> Settings -> API Keys (Test / Live)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# 4. UPI & GOOGLE PAY MERCHANDISE
# Your UPI ID for QR code generation (e.g., yourname@okaxis, yourname@okhdfcbank, business@upi)
VENDING_UPI_ID=santra.vending@upi
VENDING_PAYEE_NAME=Digital Sanitary Napkin Vending

# 5. HARDWARE RELAY / SERIAL CONFIGURATION (Optional for physical vending kiosk)
# Default motor actuation slot and hardware pulse duration
DEFAULT_DISPENSE_SLOT=Tray-A1
HARDWARE_PULSE_DURATION_MS=1500
